{
  "name": "scaler-pi-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SCALER Pi extension for supervised agentic orchestration.",
  "license": "Apache-2.0",
  "author": "Nikola Slavchev LZ1NKL",
  "pi": {
    "extensions": ["./extensions/scaler/index.ts"]
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration:mock",
    "test:unit": "node --test --import tsx test/*.test.ts",
    "test:conformance": "node --test --import tsx test/conformance.test.ts test/autopilot.test.ts",
    "test:integration": "npm run test:integration:mock",
    "test:integration:mock": "node --test --import tsx test/integration/mock/*.test.ts",
    "test:integration:real": "node --test --import tsx test/integration/real/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "marked": "18.0.5",
    "typebox": "^1.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
